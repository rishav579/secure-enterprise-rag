# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME="Secure Enterprise RAG"
DEBUG=True

# Database Configuration (PostgreSQL with pgvector)
# For local host development against Docker Compose:
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=change_this_in_production
POSTGRES_DB=rag_enterprise_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Async Connection String
DATABASE_URL=postgresql+asyncpg://rag_admin:change_this_in_production@localhost:5432/rag_enterprise_db

# Security & Authentication
# Generate a secure 32+ byte secret using: openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# GenAI Services & Models (Google Gemini)
GEMINI_API_KEY=
# LLM Model: gemini-3.7-flash (source code default) or gemini-3.1-flash-lite (production deployment option)
LLM_MODEL=gemini-3.7-flash
EMBEDDING_MODEL=gemini-embedding-2

# CORS Settings (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80
